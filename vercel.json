{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "functions": {
    "dist/index.js": {
      "runtime": "nodejs20.x@20"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/dist/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/dist/index.js"
    }
  ]
}
