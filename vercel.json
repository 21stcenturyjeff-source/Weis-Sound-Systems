{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/index.js"
    },
    {
      "source": "/api/oauth/:path*",
      "destination": "/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ]
}
